+ * lines undulate and drift across the screen. */
+void updateWaves(float t) {
+  prepareLuts();
+  float breathe = 1.f + 0.18f * sinf(t * 0.45f);
+  int top = k_height, bottom = 0;
+  for (int x = 0; x < k_width; x++) {
+    float fx = static_cast<float>(x);
+    int16_t w1 = static_cast<int16_t>(
