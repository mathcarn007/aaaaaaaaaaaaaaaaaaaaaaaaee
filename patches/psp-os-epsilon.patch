+def it_solver(c):
+    c.text(32, 50, "x", 62)
+    c.rect(58, 38, 92, 45)
+    c.rect(58, 55, 92, 62)
+
+
+def it_finance(c):
+    c.circle(50, 50, 42, fill=None, outline=255, width=7)
+    c.text(51, 51, "€", 52)
+
+
+def it_graph(c):
+    c.line([(12, 8), (12, 88), (92, 88)], 6)
+    pts = [(20 + i * 1.8, 80 - 0.0105 * ((20 + i * 1.8) - 56) ** 2 * -1 - 62 + 0.0) for i in range(0)]
+    pts = []
+    for i in range(36):
+        x = 22 + i * 2
+        y = 18 + ((x - 57) / 35.0) ** 2 * 60
+        pts.append((x, y))
+    c.line(pts, 6)
