+    for i in range(teeth):
+        a = i * 2 * math.pi / teeth
+        dx, dy = math.cos(a), math.sin(a)
+        px, py = -dy, dx
+        w = 8
+        r0, r1 = 30, 44
+        c.poly([(cx + dx * r0 + px * w, cy + dy * r0 + py * w),
