+
+def it_sequence(c):
+    c.line([(10, 8), (10, 90), (94, 90)], 5)
+    for i in range(5):
+        x = 24 + i * 16
+        y = 78 - (i * i) * 3.6
+        c.circle(x, y, 6.5)
+
+
+def it_regression(c):
+    pts = [(20, 74), (30, 62), (40, 66), (52, 50), (62, 46), (72, 30), (82, 28)]
+    for x, y in pts:
+        c.circle(x, y, 5.5)
+    c.line([(10, 84), (92, 20)], 5)
+
+
+def it_statistics(c):
+    heights = [24, 46, 72, 56, 30]
+    for i, h in enumerate(heights):
+        x = 9 + i * 17
+        c.rect(x, 90 - h, x + 15, 90)
+
+
+def bell(c, filled, tails=False):
+    pts = []
+    for i in range(81):
+        x = 6 + i * 1.1
+        u = (x - 50) / 15.0
+        y = 86 - 70 * math.exp(-u * u / 2)
+        pts.append((x, y))
+    if filled:
+        c.poly(pts + [(94, 90), (6, 90)])
+    else:
+        c.line(pts, 6)
+        c.rect(4, 87, 96, 92)
+        if tails:
+            left = [p for p in pts if p[0] <= 26]
+            right = [p for p in pts if p[0] >= 74]
+            c.poly(left + [(26, 90), (6, 90)])
+            c.poly(right + [(94, 90), (74, 90)])
+
+
+def it_distributions(c):
+    bell(c, filled=True)
+
+
+def it_inference(c):
+    bell(c, filled=False, tails=True)
+
+
+def it_elements(c):
+    # periodic table silhouette
+    u = 11.5
+    cells = [(0, 0), (7, 0),
+             (0, 1), (1, 1), (5, 1), (6, 1), (7, 1),
+             (0, 2), (1, 2), (2, 2), (3, 2), (4, 2), (5, 2), (6, 2), (7, 2),
+             (0, 3), (1, 3), (2, 3), (3, 3), (4, 3), (5, 3), (6, 3), (7, 3)]
+    for (x, y) in cells:
+        x0 = 4 + x * u
+        y0 = 24 + y * u
+        c.rrect(x0, y0, x0 + u - 2.5, y0 + u - 2.5, 1.5)
+    for x in range(2, 7):
+        x0 = 4 + x * u
+        c.rrect(x0, 24 + 4.5 * u, x0 + u - 2.5, 24 + 5.5 * u - 2.5, 1.5)
