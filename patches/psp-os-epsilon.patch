+    for (int16_t w : {w2, w3, w4}) {
+      lo = w < lo ? w : lo;
+      hi = w > hi ? w : hi;
+    }
+    top = lo < top ? lo : top;
+    bottom = hi > bottom ? hi : bottom;
+  }
