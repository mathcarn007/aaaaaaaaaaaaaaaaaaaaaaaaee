+        f"constexpr int k_itemSmallSize = {ITEM_SMALL};\nconstexpr int k_itemBigSize = {ITEM_BIG + 2 * GLOW};\n",
+        f"constexpr int k_glow = {GLOW};\n\n",
+    ]
+    previews = []
+    for name, fn in CATEGORIES:
+        small = render(fn, CAT_SMALL)
+        big = with_glow(render(fn, CAT_BIG), GLOW)
+        parts.append(c_array(name + "_small", small))
+        parts.append(c_array(name + "_big", big))
+        previews.append((small, big))
+    for name, fn in ITEMS:
+        small = render(fn, ITEM_SMALL)
+        big = with_glow(render(fn, ITEM_BIG), GLOW)
+        parts.append(c_array(name + "_small", small))
+        parts.append(c_array(name + "_big", big))
+        previews.append((small, big))
+
+    def table(prefix, entries, suffix):
+        return f"constexpr const uint8_t* {prefix}{suffix.capitalize()}[] = {{" + ", ".join(
+            n + "_" + suffix for n, _ in entries) + "};\n"
+
+    parts.append(table("k_cat", CATEGORIES, "small"))
+    parts.append(table("k_cat", CATEGORIES, "big"))
+    parts.append(table("k_item", ITEMS, "small"))
+    parts.append(table("k_item", ITEMS, "big"))
+    parts.append("\n}  // namespace PSPIcons\n}  // namespace Home\n")
+    with open(out, "w") as f:
+        f.write("".join(parts))
+
+    if preview:
+        cell = 60
+        sheet = Image.new("RGB", (cell * 2, cell * len(previews)), (40, 90, 180))
+        for i, (s, b) in enumerate(previews):
+            white = Image.new("RGB", s.size, (255, 255, 255))
+            sheet.paste(white, (5, i * cell + 5), s)
+            white = Image.new("RGB", b.size, (255, 255, 255))
+            sheet.paste(white, (cell + 5, i * cell + 5), b)
+        sheet = sheet.resize((sheet.width * 2, sheet.height * 2), Image.NEAREST)
+        sheet.save(preview)
+
+
+if __name__ == "__main__":
+    main()
