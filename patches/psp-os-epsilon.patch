+        7.f * sinf(fx * 0.047f + 1.f - t * 0.9f));
+    int16_t w2 = static_cast<int16_t>(
+        156.f + 30.f * breathe * sinf(fx * 0.0145f + 2.3f + t * 0.40f));
+    int16_t w3 = static_cast<int16_t>(
+        166.f + 17.f * sinf(fx * 0.0300f + 4.0f - t * 0.70f));
+    int16_t w4 = static_cast<int16_t>(
+        142.f + 24.f * sinf(fx * 0.0110f + 5.0f + t * 0.25f) +
+        5.f * sinf(fx * 0.06f - t * 1.3f));
+    s_wave1[x] = w1;
+    s_wave2[x] = w2;
+    s_wave3[x] = w3;
+    s_wave4[x] = w4;
