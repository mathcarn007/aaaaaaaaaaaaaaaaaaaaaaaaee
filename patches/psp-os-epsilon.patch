+        bb = self.d.textbbox((0, 0), txt, font=f)
+        w, h = bb[2] - bb[0], bb[3] - bb[1]
+        self.d.text((self.s(cx) - w / 2 - bb[0], self.s(cy) - h / 2 - bb[1]), txt, font=f, fill=fill)
