+def with_glow(icon, pad):
+    w = icon.width + 2 * pad
+    base = Image.new("L", (w, w), 0)
+    base.paste(icon, (pad, pad))
+    glow = base.filter(ImageFilter.GaussianBlur(pad / 2.2))
+    glow = glow.point(lambda v: min(255, int(v * 0.85)))
+    return ImageChops.lighter(base, glow)
+
+
+def c_array(name, img):
+    data = list(img.tobytes())
+    lines = []
+    for i in range(0, len(data), 24):
+        lines.append("  " + ", ".join(str(v) for v in data[i:i + 24]) + ",")
+    return f"constexpr uint8_t {name}[{len(data)}] = {{\n" + "\n".join(lines) + "\n};\n"
